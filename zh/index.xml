 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td style="text-align:left; vertical-align:middle;"&gt;$\pm 1$&lt;/td&gt;
 &lt;td style="text-align:right; vertical-align:middle;"&gt;$1$&lt;/td&gt;
