 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td style="text-align:left; vertical-align:middle;"&gt;$\pm 0.2$&lt;/td&gt;
 &lt;td style="text-align:right; vertical-align:middle;"&gt;$25$&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td style="text-align:left; vertical-align:middle;"&gt;$\pm 0.1$&lt;/td&gt;
 &lt;td style="text-align:right; vertical-align:middle;"&gt;$100$&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td style="text-align:left; vertical-align:middle;"&gt;$\pm 0.05$&lt;/td&gt;
